# MongoDB — local MongoDB or the docker-compose service (`npm run db:up`)
MONGODB_URI=mongodb://127.0.0.1:27017/aura-estates

# Auth.js (NextAuth v5) — generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=replace-with-a-long-random-string
AUTH_TRUST_HOST=true

# UploadThing — Dashboard → API Keys → copy the V7 token
UPLOADTHING_TOKEN=

# Public site URL used for canonical URLs, sitemap.xml, OpenGraph and JSON-LD
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: map tiles. Defaults to keyless OpenStreetMap tiles with a muted CSS filter.
# For production traffic use a keyed light style, e.g. Stadia "alidade_smooth":
# NEXT_PUBLIC_MAP_TILE_URL=https://tiles.stadiamaps.com/tiles/alidade_smooth/{z}/{x}/{y}{r}.png?api_key=YOUR_KEY
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=&copy; Stadia Maps &copy; OpenMapTiles &copy; OpenStreetMap contributors
